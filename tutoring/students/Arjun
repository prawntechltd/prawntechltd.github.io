      ["5.10.1.1","Using the Earth's resources and sustainable development"],
      ["5.10.1.2","Potable water"],
      ["5.10.1.3","Waste water treatment"],
      ["5.10.1.4","Alternative methods of extracting metals",true]
    ]},
    {num:"5.10.2", title:"Life cycle assessment and recycling", subs:[
      ["5.10.2.1","Life cycle assessment"],
      ["5.10.2.2","Ways of reducing the use of resources"]
    ]}
  ]},
  {subject:"chem", code:"5.11", title:"Key ideas (Chemistry)", topics:[
    {num:"5.11", title:"Key ideas summary", subs:[]}
  ]}
];

// ---------- storage ----------
const STORAGE_KEY = "aqa-8464-checklist-p20-120";
const SERVER_ENDPOINT = "checklist-api.php"; // same folder as this HTML file
let state = {};
try{
  const raw = localStorage.getItem(STORAGE_KEY);
  if(raw) state = JSON.parse(raw);
}catch(e){ state = {}; }

function save(){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }catch(e){ /* ignore */ }
}

// ---------- build DOM ----------
const main = document.getElementById('main');
let lastSubject = null;

DATA.forEach((section, sIdx) => {
  if(section.subject !== lastSubject){
    const h = document.createElement('div');
    h.className = 'subject-heading ' + section.subject;
    h.textContent = section.subject === 'bio' ? 'Biology' : 'Chemistry';
    main.appendChild(h);
    lastSubject = section.subject;
  }

  const sectionEl = document.createElement('div');
  sectionEl.className = 'section ' + section.subject;
  sectionEl.id = 'sec-' + sIdx;

  const head = document.createElement('button');
  head.className = 'section-head';
  head.innerHTML = `
    <span class="chevron"></span>
    <span class="section-code">${section.code}</span>
    <span class="section-title">${section.title}</span>
    <span class="section-count" data-count></span>
  `;
  sectionEl.appendChild(head);

  const body = document.createElement('div');
  body.className = 'section-body';

  section.topics.forEach((topic, tIdx) => {
    const topicEl = document.createElement('div');
    topicEl.className = 'topic';
    const topicId = 'topic-' + sIdx + '-' + tIdx;

    if(topic.subs.length === 0){
      // leaf topic itself is checkable
      const row = document.createElement('div');
      row.className = 'topic-row';
      row.style.cursor = 'pointer';
      row.innerHTML = `
        <input type="checkbox" id="${topicId}">
        <label class="topic-label" for="${topicId}">
          <span class="topic-num">${topic.num}</span>${topic.title}
        </label>
      `;
      topicEl.appendChild(row);
      const cb = row.querySelector('input');
      cb.checked = !!state[topicId];
      cb.addEventListener('change', () => {
        state[topicId] = cb.checked;
        topicEl.classList.toggle('done', cb.checked);
        save(); refresh(); scheduleServerSync();
      });
      topicEl.classList.toggle('done', cb.checked);
    } else {
      const row = document.createElement('div');
      row.className = 'topic-row';
      row.innerHTML = `
        <span class="topic-label" style="padding-left:28px;">
          <span class="topic-num">${topic.num}</span>${topic.title}
        </span>
        <span class="topic-progress" data-topic-progress></span>
      `;
      topicEl.appendChild(row);

      const list = document.createElement('ul');
      list.className = 'sub-list';
      topic.subs.forEach((sub, subIdx) => {
        const [num, title, ht] = sub;
        const subId = 'sub-' + sIdx + '-' + tIdx + '-' + subIdx;
        const li = document.createElement('li');
        li.className = 'sub-item';
        li.innerHTML = `
          <label class="sub-row">
            <input type="checkbox" id="${subId}">
            <span class="sub-num">${num}</span>
            <span class="sub-text">${title}${ht ? '<span class="ht-badge">HT only</span>' : ''}</span>
          </label>
        `;
        list.appendChild(li);
        const cb = li.querySelector('input');
        cb.checked = !!state[subId];
        li.classList.toggle('done', cb.checked);
        cb.addEventListener('change', () => {
          state[subId] = cb.checked;
          li.classList.toggle('done', cb.checked);
          save(); refresh(); scheduleServerSync();
        });
      });
      topicEl.appendChild(list);
    }

    body.appendChild(topicEl);
  });

  sectionEl.appendChild(body);
  main.appendChild(sectionEl);

  head.addEventListener('click', () => {
    sectionEl.classList.toggle('open');
  });
});

// ---------- progress calc ----------
function refresh(){
  let total = 0, checked = 0;

  DATA.forEach((section, sIdx) => {
    let secTotal = 0, secChecked = 0;
    section.topics.forEach((topic, tIdx) => {
      if(topic.subs.length === 0){
        const id = 'topic-' + sIdx + '-' + tIdx;
        secTotal++;
        if(state[id]) secChecked++;
      } else {
        let tTotal = topic.subs.length, tChecked = 0;
        topic.subs.forEach((sub, subIdx) => {
          const id = 'sub-' + sIdx + '-' + tIdx + '-' + subIdx;
          if(state[id]) tChecked++;
        });
        secTotal += tTotal; secChecked += tChecked;
        const progEl = document.querySelector(`#sec-${sIdx} .topic:nth-of-type(${tIdx+1}) [data-topic-progress]`);
        if(progEl) progEl.textContent = `${tChecked}/${tTotal}`;
        const topicEl = progEl ? progEl.closest('.topic') : null;
        if(topicEl) topicEl.classList.toggle('done', tChecked === tTotal);
      }
    });
    total += secTotal; checked += secChecked;
    const countEl = document.querySelector(`#sec-${sIdx} [data-count]`);
    if(countEl) countEl.textContent = `${secChecked}/${secTotal}`;
  });

  const pct = total ? Math.round((checked/total)*100) : 0;
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressText').textContent = `${checked} of ${total} checked`;
  document.getElementById('progressPct').textContent = pct + '%';
}

refresh();

// ---------- controls ----------
document.getElementById('expandAll').addEventListener('click', () => {
  document.querySelectorAll('.section').forEach(s => s.classList.add('open'));
});
document.getElementById('collapseAll').addEventListener('click', () => {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('open'));
});
document.getElementById('resetAll').addEventListener('click', () => {
  if(!confirm('Clear all checked progress on this device?')) return;
  state = {};
  save();
  document.querySelectorAll('input[type=checkbox]').forEach(cb => cb.checked = false);
  document.querySelectorAll('.done').forEach(el => el.classList.remove('done'));
  refresh();
  scheduleServerSync();
});

// open first section by default
document.querySelector('.section')?.classList.add('open');

// ---------- server sync ----------
const fileStatus = document.getElementById('fileStatus');
function setStatus(msg){ fileStatus.textContent = msg; }

// Apply a loaded state object to the checkboxes on screen.
function applyState(newState){
  state = newState || {};
  document.querySelectorAll('input[type=checkbox]').forEach(cb => {
    cb.checked = !!state[cb.id];
    const container = cb.closest('.sub-item') || cb.closest('.topic');
    if(container) container.classList.toggle('done', cb.checked);
  });
  save();
  refresh();
}

async function loadFromServer(showStatus){
  try{
    const res = await fetch(SERVER_ENDPOINT, {cache:'no-store'});
    if(!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    if(data && Object.keys(data).length){
      applyState(data);
    }
    if(showStatus) setStatus('Synced from server at ' + new Date().toLocaleTimeString());
    return true;
  }catch(err){
    if(showStatus) setStatus('Could not reach ' + SERVER_ENDPOINT + ' — using this browser\'s saved copy instead.');
    return false;
  }
}

async function saveToServer(showStatus){
  try{
    const res = await fetch(SERVER_ENDPOINT, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(state)
    });
    if(!res.ok) throw new Error('HTTP ' + res.status);
    setStatus('Saved to server at ' + new Date().toLocaleTimeString());
    return true;
  }catch(err){
    setStatus('Could not save to server (' + err.message + ') — your progress is still kept in this browser.');
    return false;
  }
}

let syncTimer = null;
function scheduleServerSync(){
  clearTimeout(syncTimer);
  setStatus('Saving…');
  syncTimer = setTimeout(() => saveToServer(false), 600);
}

document.getElementById('syncNow').addEventListener('click', () => saveToServer(true));

// On page load: try the server first, then fall back to whatever's in
// localStorage (already applied above) if the server can't be reached —
// e.g. when this file is opened directly as file:// rather than served.
loadFromServer(true);

// ---------- local backup (download / restore a JSON file) ----------
let fileHandle = null; // remembered for repeat saves in the same session (Chrome/Edge)

async function downloadBackup(){
  const data = JSON.stringify(state, null, 2);
  const blob = new Blob([data], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'checklist-progress-backup.json';
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
  setStatus('Downloaded a local backup file.');
}

function restoreBackup(){
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = 'application/json';
  input.addEventListener('change', () => {
    const file = input.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try{
        applyState(JSON.parse(reader.result));
        setStatus('Restored from ' + file.name + ' — click "Sync now" to push it to the server.');
      }catch(e){
        setStatus('Could not read that file — is it a checklist backup .json?');
      }
    };
    reader.readAsText(file);
  });
  input.click();
}

document.getElementById('saveToFile').addEventListener('click', downloadBackup);
document.getElementById('loadFromFile').addEventListener('click', restoreBackup);
</script>

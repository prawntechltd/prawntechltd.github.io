    --ink-soft:#565f57;
    --rule:#dcd9cd;
    --bio:#2f5233;
    --bio-tint:#e7ede4;
    --chem:#1f4e6b;
    --chem-tint:#e5edf1;
    --amber:#a5641c;
    --amber-tint:#f3e6d3;
    --done:#2f6b3d;
    --done-tint:#e2ede2;
    --focus:#1f4e6b;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',system-ui,sans-serif;
    line-height:1.5;
    padding-bottom:80px;
  }
  a{color:inherit;}

  /* ---------- header ---------- */
  header{
    position:sticky;
    top:0;
    z-index:20;
    background:var(--paper);
    border-bottom:1px solid var(--rule);
    padding:20px 24px 16px;
  }
  .header-inner{max-width:740px;margin:0 auto;}
  .eyebrow-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;}
  h1{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:1.5rem;
    margin:0 0 2px;
    letter-spacing:-0.01em;
  }
  .subtitle{
    color:var(--ink-soft);
    font-size:0.88rem;
    margin:0;
  }
  .spec-code{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.72rem;
    color:var(--ink-soft);
    white-space:nowrap;
  }

  .progress-wrap{margin-top:14px;}
  .progress-track{
    height:8px;
    background:var(--rule);
    border-radius:5px;
    overflow:hidden;
  }
  .progress-fill{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,var(--bio),var(--chem));
    border-radius:5px;
    transition:width .35s ease;
  }
  .progress-label{
    display:flex;
    justify-content:space-between;
    font-size:0.78rem;
    color:var(--ink-soft);
    margin-top:6px;
    font-family:'IBM Plex Mono',monospace;
  }

  /* ---------- controls ---------- */
  .controls{
    max-width:740px;
    margin:16px auto 0;
    padding:0 24px;
    display:flex;
    gap:10px;
    flex-wrap:wrap;
  }
  button.ctrl{
    font-family:'Inter',sans-serif;
    font-size:0.8rem;
    font-weight:600;
    background:var(--paper-raised);
    border:1px solid var(--rule);
    color:var(--ink);
    padding:7px 14px;
    border-radius:7px;
    cursor:pointer;
  }
  button.ctrl:hover{border-color:var(--ink-soft);}
  button.ctrl:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}
  button.ctrl.danger{color:#8a3324;}

  /* ---------- main ---------- */
  main{max-width:740px;margin:0 auto;padding:22px 24px 0;}

  .subject-heading{
    font-family:'Fraunces',serif;
    font-size:1.05rem;
    font-weight:600;
    margin:34px 0 12px;
    padding-bottom:6px;
    border-bottom:2px solid var(--rule);
  }
  .subject-heading.bio{color:var(--bio);}
  .subject-heading.chem{color:var(--chem);}
  .subject-heading:first-child{margin-top:0;}

  .section{
    background:var(--paper-raised);
    border:1px solid var(--rule);
    border-left:4px solid var(--section-color, var(--bio));
    border-radius:9px;
    margin-bottom:14px;
    overflow:hidden;
  }
  .section.bio{--section-color:var(--bio);}
  .section.chem{--section-color:var(--chem);}

  .section-head{
    width:100%;
    display:flex;
    align-items:center;
    gap:12px;
    padding:14px 16px;
    background:none;
    border:none;
    cursor:pointer;
    text-align:left;
    font-family:inherit;
  }
  .section-head:focus-visible{outline:2px solid var(--focus);outline-offset:-2px;}
  .section-code{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.78rem;
    font-weight:600;
    color:var(--section-color);
    background:var(--tint, var(--bio-tint));
    padding:2px 7px;
    border-radius:5px;
    flex-shrink:0;
  }
  .section.bio .section-code{--tint:var(--bio-tint);}
  .section.chem .section-code{--tint:var(--chem-tint);}

  .section-title{
    font-weight:600;
    font-size:0.94rem;
    flex:1;
  }
  .section-count{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.74rem;
    color:var(--ink-soft);
    flex-shrink:0;
  }
  .chevron{
    width:9px;height:9px;
    border-right:2px solid var(--ink-soft);
    border-bottom:2px solid var(--ink-soft);
    transform:rotate(-45deg);
    transition:transform .2s ease;
    flex-shrink:0;
    margin-right:2px;
  }
  .section.open .chevron{transform:rotate(45deg);}

  .section-body{
    display:none;
    padding:0 16px 14px;
    border-top:1px solid var(--rule);
  }
  .section.open .section-body{display:block;}

  .topic{margin-top:14px;}
  .topic-row{
    display:flex;
    align-items:flex-start;
    gap:10px;
    padding:6px 0;
  }
  .topic-label{
    font-weight:600;
    font-size:0.9rem;
    display:flex;
    gap:8px;
    align-items:baseline;
    flex-wrap:wrap;
  }
  .topic-num{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.76rem;
    color:var(--section-color);
    font-weight:600;
  }

  .sub-list{
    list-style:none;
    margin:2px 0 0;
    padding:0 0 0 26px;
    border-left:1px solid var(--rule);
  }
  .sub-item{padding:5px 0 5px 12px;}
  .sub-row{
    display:flex;
    align-items:flex-start;
    gap:10px;
    cursor:pointer;
  }
  .sub-num{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.72rem;
    color:var(--ink-soft);
    padding-top:1px;
    flex-shrink:0;
    min-width:52px;
  }
  .sub-text{font-size:0.88rem;}
  .ht-badge{
    display:inline-block;
    font-family:'IBM Plex Mono',monospace;
    font-size:0.62rem;
    font-weight:600;
    color:var(--amber);
    background:var(--amber-tint);
    padding:1px 5px;
    border-radius:4px;
    margin-left:6px;
    vertical-align:1px;
    letter-spacing:0.02em;
  }

  input[type=checkbox]{
    appearance:none;
    -webkit-appearance:none;
    width:18px;height:18px;
    border:1.5px solid var(--ink-soft);
    border-radius:5px;
    flex-shrink:0;
    margin:1px 0 0;
    cursor:pointer;
    position:relative;
    background:var(--paper-raised);
  }
  input[type=checkbox]:checked{
    background:var(--done);
    border-color:var(--done);
  }
  input[type=checkbox]:checked::after{
    content:'';
    position:absolute;
    left:5px;top:1px;
    width:5px;height:9px;
    border:solid #fff;
    border-width:0 2px 2px 0;
    transform:rotate(40deg);
  }
  input[type=checkbox]:focus-visible{outline:2px solid var(--focus);outline-offset:2px;}
  .sub-item.done .sub-text{color:var(--ink-soft);text-decoration:line-through;text-decoration-color:var(--rule);}
  .topic.done .topic-label{color:var(--ink-soft);}
  .topic.done .topic-num{color:var(--ink-soft);}

  .topic-progress{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.7rem;
    color:var(--ink-soft);
    margin-left:auto;
    flex-shrink:0;
    padding-top:2px;
  }

  footer{
    max-width:740px;
    margin:36px auto 0;
    padding:0 24px;
    font-size:0.78rem;
    color:var(--ink-soft);
  }

  @media (max-width:480px){
    .section-count{display:none;}
    .sub-num{min-width:44px;}
